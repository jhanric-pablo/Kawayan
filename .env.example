# Server Configuration
PORT=3001
NODE_ENV=development
APP_NAME="Kawayan AI"
APP_VERSION=1.0.0

# Supabase (primary DB in production — server.js runs on SupabaseService)
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Security & Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_TIMEOUT=24h

# Email (password reset links). Uses Gmail SMTP via nodemailer.
# Requires 2-Step Verification on the Google account + an App Password:
#   myaccount.google.com -> Security -> App passwords (16 chars, no spaces).
# APP_URL is the base for reset links. Dev = the Vite port (3000), NOT the API
# port (3001, which only serves the prod dist/ build). Prod = your real domain.
APP_URL=http://localhost:3000
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM="Kawayan <youraddress@gmail.com>"

# Google Gemini AI (text generation)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (image generation, free tier)
# dash.cloudflare.com -> Account ID from the dashboard sidebar; API token from
# My Profile -> API Tokens -> Create Token -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Payment Integration (Xendit)
XENDIT_SECRET_KEY=your_xendit_secret_key
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_xendit_webhook_token

# Social Media Integration (TikTok)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_public

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
